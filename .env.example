# =====================================================================
# DocuMind — The Intelligent Paper Studio Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Firebase Authentication & Cloud Services (Web Client)
# Obtain these values from your Firebase Console (Project Settings -> General -> Your apps -> Web app)
# If left empty, DocuMind will automatically use its built-in simulated local auth session.
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# Used for document summarization, semantic entity parsing, and theme recommendations.
# Get a free Gemini API key from https://aistudio.google.com/
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# 3. Backend Express Server Configuration
# ---------------------------------------------------------------------
PORT=5000
CORS_ORIGIN=*
ADMIN_SECRET_KEY=documind-admin-secret

# ---------------------------------------------------------------------
# 4. Firebase Admin SDK Configuration (Backend / Server-Only)
# Option A: Path to Service Account JSON file (e.g. locally or in Google Cloud)
# Option B: Individual environment variables for hosting platforms like Vercel
# ---------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# 5. LG AI Research EXAONE API Configuration (Planned Integration — Coming Soon)
# Inactive placeholder for future administrator manual activation.
# Regional access pending. Leave empty until the administrator adds the key.
# ---------------------------------------------------------------------
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.exaone.ai/v1
EXAONE_MODEL=k-exaone_v2.5
