# =====================================================================
# DocuMind — The Intelligent Paper Studio Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Firebase Authentication & Cloud Services
# Obtain these values from your Firebase Console (Project Settings -> General -> Your apps -> Web app)
# If left empty, DocuMind will automatically use its built-in simulated local auth session.
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# Used for document summarization, semantic entity parsing, and theme recommendations.
# Get a free Gemini API key from https://aistudio.google.com/
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# 3. Backend Express Server Configuration
# ---------------------------------------------------------------------
PORT=5000
CORS_ORIGIN=*
ADMIN_SECRET_KEY=documind-admin-secret

# ---------------------------------------------------------------------
# 4. Optional MongoDB Database Connection
# If omitted or unavailable, the backend gracefully operates in-memory.
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/documind
